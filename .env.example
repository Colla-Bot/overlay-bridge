# The Discord application the bridge signs in as. See "The Discord application" in README.md.

# The application's client ID.
COLLABOT_BRIDGE_DISCORD_CLIENT_ID=

# An origin registered for the application's RPC connections. The bridge sends it as `Origin`.
COLLABOT_BRIDGE_DISCORD_ORIGIN=

# A service that takes {"code": …} by POST and answers with Discord's token response.
COLLABOT_BRIDGE_DISCORD_TOKEN_URL=
