{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CollaBot Overlay Bridge",
  "version": "0.1.0",
  "identifier": "bot.colla.overlay.bridge",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true,
    "beforeBuildCommand": "npm run licenses"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CollaBot Overlay Bridge",
        "width": 380,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CollaBot",
    "copyright": "© 2026 CollaBot",
    "homepage": "https://overlay.colla.bot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-only",
    "licenseFile": "../NOTICE.txt",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["collabot-overlay"]
      }
    }
  }
}
